# Copy this file to .env and fill in real values before running the backend.

# Secret used to sign JWTs — override with a long random value in any real deployment.
JWT_SECRET=change-me-to-a-random-secret

# SQLAlchemy database URL. Defaults to a local SQLite file under backend/ if unset.
# DATABASE_URL=sqlite:////absolute/path/to/backend/app.db

# LLM provider credentials — set the one matching LLM_PROVIDER below.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Which provider app/llm/factory.py should use: "claude" or "openai".
LLM_PROVIDER=openai
CLAUDE_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o

# Comma-separated list of origins allowed to call this API from a browser.
# Add your deployed frontend's URL here (e.g. https://your-frontend.cloudtype.app).
CORS_ORIGINS=http://localhost:3000

# 온통청년(청년정책통합정보시스템) Open API 인증키.
# 발급 방법: README.md의 "policy_matcher — 온통청년 API 키 발급" 절 참고.
YOUTH_CENTER_API_KEY=

# 관리자 대시보드(/admin) 계정. 앱 시작 시 이 이메일/비밀번호로 자동 생성되며
# (app/auth/service.py의 seed_admin_user), 이 이메일과 일치하는 사용자만
# /admin/* API에 접근할 수 있다. 운영 환경에서는 반드시 값을 바꿔서 배포할 것.
# ADMIN_EMAIL=admin@naver.com
# ADMIN_PASSWORD=admin123!
